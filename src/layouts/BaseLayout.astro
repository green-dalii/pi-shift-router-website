---
import '../index.css';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import { getTranslations, swapLocalePrefix, type Locale } from '../content/locales';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  locale?: Locale;
  /** Pathname of the current page (used by Header / Footer language switcher). */
  pathname?: string;
  /** Keep a page out of the index and out of the sitemap-facing metadata. */
  noindex?: boolean;
}

const {
  title,
  description = '',
  keywords = '',
  locale = 'en',
  pathname = '/',
  noindex = false,
} = Astro.props;

const t = getTranslations(locale);
const siteUrl = Astro.site!;
const canonical = new URL(pathname, siteUrl).href;

// hreflang: both locales → same page
const hreflangEntries = (['en', 'zh'] as const).map((code) => ({
  code,
  href: new URL(swapLocalePrefix(pathname, code), siteUrl).href,
}));
const xDefault = hreflangEntries.find((h) => h.code === 'en')?.href ?? siteUrl.href;

const ogLocale = locale === 'zh' ? 'zh_CN' : 'en_US';
const ogImage = new URL('/og-image.png', siteUrl).href;

// Resolved through Vite so the hashed asset path stays correct after a build.
import manrope800Url from '@fontsource/manrope/files/manrope-latin-800-normal.woff2?url';
import inter400Url from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
const manrope800 = manrope800Url;
const inter400 = inter400Url;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteUrl.href + '#website',
      name: t.footer.brand,
      url: siteUrl.href,
      description,
      inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': siteUrl.href + '#software',
      name: t.footer.brand,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Cross-platform',
      softwareVersion: '1.8.0',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://opensource.org/licenses/MIT',
      description,
      url: 'https://github.com/green-dalii/pi-shift-router',
      codeRepository: 'https://github.com/green-dalii/pi-shift-router',
      downloadUrl: 'https://www.npmjs.com/package/pi-shift-router',
    },
    /* Emitted for both locales, each declaring its own language: the ZH page
       carries nine real FAQ entries and was shipping without any structured
       data for them. `inLanguage` is what keeps the two entities distinct. */
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl.href}#faq-${locale}`,
      inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
      mainEntity: t.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} style="overflow-x: hidden;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#9fe870" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <!-- LLM-readable product summary (GEO: picked up by AI crawlers) -->
    <!-- name: shift-router | type: software / npm package / pi-coding-agent extension + DeepSeek Harness plugin | license: MIT | language: TypeScript | runtime: Node.js >= 24 | dependencies: one host-provided (pi-tui) | npm: https://www.npmjs.com/package/pi-shift-router | repo: https://github.com/green-dalii/pi-shift-router (pi) / https://github.com/green-dalii/dsh-shift-router (DSH) | features: two-tier routing by expected cost (theta = 1/reworkPenalty), gear presets (eco/default/sport), pluggable judge (fast chain / dedicated judge chain / decision model such as Jev, Beta opt-in), judge availability ladder (never stall, never guess), LLM judge, multi-model fallback chains, exponential-backoff runtime failover (429/402/5xx + Codex usage-limit), cache-aware routing, task-level orchestration (Smart CTO delegates to Fast subagents, post-turn acceptance audit, per-worker cost ledger), TUI status dashboard, zero-config defaults | author: green-dalii -->
    {hreflangEntries.map((h) => (
      <link rel="alternate" hreflang={h.code} href={h.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="alternate" type="text/markdown" title="LLMs.txt (GEO)" href="/llms.txt" />

    <!-- The hero paints in Manrope 800 and body in Inter 400: preload both so
         the first text paint never waits for a CSS-discovered font. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href={manrope800} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href={inter400} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.footer.brand} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="bg-canvas-soft text-ink min-h-screen">
    <Header locale={locale} pathname={pathname} />
    <main class="pt-16">
      <slot />
    </main>
    <Footer locale={locale} pathname={pathname} />

    <script>
      /* ── Magnetic CTA ───────────────────────────────────────────────────────
         The one pointer-following element on the site, and only the primary
         action. Disabled entirely under reduced motion or a coarse pointer —
         it is a flourish, not an interaction the site depends on. */
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        const fine = window.matchMedia('(pointer: fine)');
        if (reduced.matches || !fine.matches) return;

        document.querySelectorAll<HTMLElement>('a.btn-primary').forEach((el) => {
          const strength = 6;
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
            const dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
            el.style.transform = `translate(${dx * strength}px, ${dy * strength}px)`;
          });
          el.addEventListener('pointerleave', () => {
            el.style.transform = '';
          });
        });
      })();
    </script>

    <script>
      /* ── Reveal system ─────────────────────────────────────────────────────
         Every `.reveal` used to run a CSS animation on page load, which meant
         anything below the fold had already finished animating before the
         reader arrived. One observer now drives the lot, so the page moves as
         it is read. Stagger comes from `data-delay`; reduced motion renders
         everything immediately at its final state. */
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

        const show = (el: HTMLElement) => el.classList.add('is-in');
        const all = () => Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

        if (reduced.matches || !('IntersectionObserver' in window)) {
          all().forEach(show);
          document.documentElement.classList.add('no-motion');
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            const batch = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            batch.forEach((entry, i) => {
              const el = entry.target as HTMLElement;
              el.style.transitionDelay = `${Math.min(i, 5) * 60}ms`;
              show(el);
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );

        all().forEach((el) => io.observe(el));

        /* Draw-in objects animate their geometry when they enter view, so the
           threshold is seen arriving rather than found already drawn.

           Progressive enhancement, not a reveal: fully drawn is the CSS
           default. Only elements still below the fold at load are armed into
           the collapsed start state. Resolution is geometric — `top` has
           entered or passed the viewport — rather than intersection-only,
           because a jump-to-anchor can teleport past an element and an
           IntersectionObserver never fires for it. A reader who scrolls fast
           therefore cannot leave one collapsed, and with JS off the bar is
           simply already drawn. */
        const drawables = Array.from(document.querySelectorAll<HTMLElement>('[data-draw]'));
        if (drawables.length) {
          drawables.forEach((el) => {
            if (el.getBoundingClientRect().top > window.innerHeight) el.classList.add('db-armed');
          });

          const resolveDrawn = () => {
            drawables.forEach((el) => {
              if (el.classList.contains('is-drawn')) return;
              // `top < innerHeight` covers both "scrolled into view" and
              // "already scrolled past" in one monotonic test.
              if (el.getBoundingClientRect().top < window.innerHeight * 0.94) {
                el.classList.add('is-drawn');
              }
            });
          };

          resolveDrawn();
          window.addEventListener('scroll', resolveDrawn, { passive: true });
          window.addEventListener('resize', resolveDrawn, { passive: true });
          document.addEventListener('qs:panel-shown', resolveDrawn);
          // One late pass for layout that settles after fonts/images land.
          window.setTimeout(resolveDrawn, 1200);
        }
      })();
    </script>
  </body>
</html>