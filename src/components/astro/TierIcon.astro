---
/**
 * Dual-state tier icons — the site's only icon family.
 *
 * The product routes between two tiers. Rather than emoji (which render
 * differently on every OS and read as informal), each tier gets a geometric
 * mark drawn in two weights:
 *
 *   engineer / cheap  — open stroke, rounded caps, weight 1.5
 *   cto / strong      — the same silhouette, solid fill
 *
 * Usage:
 *   <TierIcon tier="fast" />
 *   <TierIcon tier="smart" size={20} />
 *   <TierIcon tier="judge" />   // the decision point — always stroke
 *
 * Fill colour follows `currentColor`, so the icon takes the surface it sits on.
 */
export type Tier = 'fast' | 'smart' | 'judge';

interface Props {
  tier: Tier;
  /** Pixel size of the square box. Defaults to 1em so it tracks font-size. */
  size?: number | string;
  class?: string;
}

const { tier, size = '1em', class: className = '' } = Astro.props;
const px = typeof size === 'number' ? `${size}px` : size;
---

<span
  class:list={['tier-icon', `tier-icon--${tier}`, className]}
  style={`--ti-size:${px}`}
  aria-hidden="true"
>
  {
    /* ENGINEER — a wrench-less mark: a bracket closing around a bolt.
       Stroke variant (cheap) and solid variant (strong) share the silhouette. */
    tier === 'fast' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 8V6.5A1.5 1.5 0 0 1 6.5 5H8" />
        <path d="M16 5h1.5A1.5 1.5 0 0 1 19 6.5V8" />
        <path d="M19 16v1.5a1.5 1.5 0 0 1-1.5 1.5H16" />
        <path d="M8 19H6.5A1.5 1.5 0 0 1 5 17.5V16" />
        <circle cx="12" cy="12" r="2.25" />
      </svg>
    )
  }
  {
    /* CTO — a solid aperture: concentric rings with one gap, reading as
       "decides the shape of the work" rather than "does the work". */
    tier === 'smart' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <circle cx="12" cy="12" r="8" stroke-width="1.6" />
        <circle cx="12" cy="12" r="4.25" stroke-width="1.6" />
        <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
        <path d="M12 4v3.75" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    )
  }
  {
    /* JUDGE — the decision point itself. Always stroke: it is neither tier. */
    tier === 'judge' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4v5" />
        <path d="M5 15.5 12 9l7 6.5" />
        <circle cx="12" cy="19" r="1.75" fill="currentColor" stroke="none" />
      </svg>
    )
  }
</span>

<style>
  .tier-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ti-size);
    height: var(--ti-size);
    flex: none;
    vertical-align: -0.125em;
    color: inherit;
  }
  .tier-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
</style>
