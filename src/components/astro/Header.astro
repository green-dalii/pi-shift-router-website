---
import { getTranslations, swapLocalePrefix, type Locale } from '../../content/locales';

interface Props {
  locale: Locale;
  pathname?: string;
}

const { locale, pathname = '/' } = Astro.props;
const t = getTranslations(locale);

const githubUrl = 'https://github.com/green-dalii/pi-shift-router';

// Anchor links only exist on the landing page. When on any other page
// (e.g. /models), prefix them with the home path so they navigate back
// to the landing page first, then scroll to the section.
const homePath = locale === 'zh' ? '/zh/' : '/';
const isHome = pathname === homePath || pathname === homePath.replace(/\/$/, '') || pathname === '/';

const navItems = [
  { key: 'quick-start', label: t.nav.quickStart, href: isHome ? '#quick-start' : `${homePath}#quick-start` },
  { key: 'how-it-works', label: t.nav.howItWorks, href: isHome ? '#how-it-works' : `${homePath}#how-it-works` },
  { key: 'use-cases', label: t.nav.useCases, href: isHome ? '#use-cases' : `${homePath}#use-cases` },
  { key: 'models', label: t.nav.models, href: locale === 'zh' ? '/zh/models' : '/models' },
  { key: 'faq', label: t.nav.faq, href: isHome ? '#faq' : `${homePath}#faq` },
] as const;

const otherLocale: Locale = locale === 'en' ? 'zh' : 'en';
const otherLocaleHref = swapLocalePrefix(pathname, otherLocale);
const otherLocaleLabel = otherLocale === 'zh' ? t.nav.zhLabel : t.nav.enLabel;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 bg-canvas/85 backdrop-blur-md border-b border-ink/5 transition-all">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 flex items-center justify-between h-16">
    <a href={locale === 'zh' ? '/zh/' : '/'} class="flex items-center gap-2.5 group" aria-label="Home">
      <span class="w-8 h-8 rounded-lg bg-ink flex items-center justify-center" aria-hidden="true">
        <svg viewBox="0 0 64 64" class="w-5 h-5">
          <path d="M18 22h28M18 32h20M18 42h28" stroke="#9fe870" stroke-width="5" stroke-linecap="round"/>
          <circle cx="46" cy="32" r="4" fill="#9fe870"/>
        </svg>
      </span>
      <span class="text-[15px] font-extrabold tracking-tight text-ink group-hover:text-ink-deep transition-colors">
        {t.footer.brand}
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3 py-1.5 text-sm font-semibold text-ink/70 hover:text-ink transition-colors rounded-md hover:bg-canvas-soft"
        >
          {item.label}
        </a>
      ))}

      <div class="w-px h-5 bg-ink/10 mx-2"></div>

      <!-- Language switcher -->
      <a
        href={otherLocaleHref}
        hreflang={otherLocale}
        class="px-2.5 py-1.5 text-xs font-mono text-ink/60 hover:text-ink border border-ink/10 rounded-full hover:border-ink/25 transition-all inline-flex items-center gap-1.5"
        aria-label={`${t.nav.languageLabel}: ${otherLocaleLabel}`}
      >
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        {otherLocale === 'zh' ? '中文' : 'EN'}
      </a>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 px-3 py-1.5 text-sm font-semibold text-ink/80 hover:text-ink border border-ink/15 rounded-pill hover:border-ink/40 transition-all inline-flex items-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.84-2.34 4.68-4.57 4.93.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
        {t.nav.github}
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button id="mobile-btn" class="md:hidden p-2 text-ink" aria-label="Open menu" aria-expanded="false">
      <svg id="icon-menu" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg id="icon-close" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-canvas/95 backdrop-blur-md border-b border-ink/5 px-5 sm:px-8 pb-5">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block w-full py-3 text-base font-semibold text-ink/80 hover:text-ink transition-colors border-b border-ink/5"
      >
        {item.label}
      </a>
    ))}
    <div class="flex items-center justify-between gap-3 mt-4 pt-3">
      <a
        href={otherLocaleHref}
        hreflang={otherLocale}
        class="px-3 py-2 text-xs font-mono text-ink/70 border border-ink/10 rounded-pill inline-flex items-center gap-1.5"
      >
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        {otherLocale === 'zh' ? '中文' : 'EN'}
      </a>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-ink/80 hover:text-ink border border-ink/15 rounded-pill hover:border-ink/40 transition-all inline-flex items-center gap-1.5 px-3 py-2">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.84-2.34 4.68-4.57 4.93.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
        {t.nav.github}
      </a>
    </div>
  </div>
</header>

<script is:inline>
(function () {
  var mobileBtn = document.getElementById('mobile-btn');
  var mobileMenu = document.getElementById('mobile-menu');
  var iconMenu = document.getElementById('icon-menu');
  var iconClose = document.getElementById('icon-close');
  if (!mobileBtn || !mobileMenu) return;

  mobileBtn.addEventListener('click', function () {
    var isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    iconMenu.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
    mobileBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close mobile menu on anchor click
  document.querySelectorAll('#mobile-menu a[href^="#"]').forEach(function (a) {
    a.addEventListener('click', function () {
      mobileMenu.classList.add('hidden');
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
      mobileBtn.setAttribute('aria-expanded', 'false');
    });
  });
})();
</script>