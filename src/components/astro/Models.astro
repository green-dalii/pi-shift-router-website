---
import { getTranslations, type Locale } from '../../content/locales';
import TierIcon from './TierIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const features = [
  { key: 'judge', data: t.models.judge, icon: 'gauge' },
  { key: 'window', data: t.models.window, icon: 'activity' },
  { key: 'fallback', data: t.models.fallback, icon: 'arrow-right-circle' },
] as const;
const orch = t.models.orchestration;
---

<section id="how-it-works" class="relative py-24 sm:py-32 bg-canvas-soft">

  <div class="max-w-6xl mx-auto px-5 sm:px-8">

    <!-- Section header -->
    <div class="max-w-2xl mb-10 sm:mb-12">
      <span class="eyebrow">{t.models.label}</span>
      <h2 class="mt-4 text-[clamp(2.5rem,5vw,4.25rem)] font-extrabold tracking-tight text-ink leading-[1.05]">
        {t.models.title}
      </h2>
      <p class="mt-4 text-lg text-body max-w-lg leading-relaxed">
        {t.models.subtitle}
      </p>
    </div>

    <!-- The philosophy: plain-language explanation -->
    <div class="mb-14 sm:mb-16 max-w-3xl reveal" data-delay="0">
      <p class="text-lg sm:text-xl font-medium text-ink leading-relaxed">
        {t.models.intro}
      </p>
    </div>

    <!-- Value props: why this pays off (3 columns) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10 sm:mb-14">
      {t.models.valueProps.map((v, idx) => (
        <div class="card-green-pale p-6 reveal" data-delay={idx * 2}>
          <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center mb-4" aria-hidden="true">
            <svg class="w-4 h-4 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 class="text-base font-extrabold tracking-tight text-ink mb-2">
            {v.title}
          </h3>
          <p class="text-sm text-body leading-relaxed">
            {v.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Two tier cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">

      <!-- FAST — sage soft surface (DESIGN.md card-feature-sage) -->
      <div class="card-sage md:p-10 reveal hover:shadow-xl hover:-translate-y-1 hover:border-ink/20 transition-all duration-300 border border-ink/10 cursor-default" data-delay="0">
        <div class="flex items-baseline gap-3 mb-4">
          <h3 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink leading-none">
            {t.models.fast.tier}
          </h3>
          <TierIcon tier="fast" size={26} class="mb-1" />
        </div>
        <div class="text-sm font-mono uppercase tracking-[0.15em] text-mute mb-5">
          {t.models.fast.role}
        </div>
        <p class="text-[15px] text-body leading-relaxed mb-6">
          {t.models.fast.desc}
        </p>
        <ul class="space-y-2.5">
          {t.models.fast.bullets.map((b) => (
            <li class="flex items-start gap-2.5 text-sm text-ink/85">
              <svg class="w-4 h-4 mt-0.5 text-positive shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- SMART — dark + lime (DESIGN.md card-feature-dark) -->
      <div class="card-dark md:p-10 bg-ink text-primary reveal hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 cursor-default" data-delay="2">
        <div class="flex items-baseline gap-3 mb-4">
          <h3 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-canvas leading-none">
            {t.models.smart.tier}
          </h3>
          <TierIcon tier="smart" size={26} class="mb-1" />
        </div>
        <div class="text-sm font-mono uppercase tracking-[0.15em] text-canvas-soft/74 mb-5">
          {t.models.smart.role}
        </div>
        <p class="text-[15px] text-canvas-soft/88 leading-relaxed mb-6">
          {t.models.smart.desc}
        </p>
        <ul class="space-y-2.5">
          {t.models.smart.bullets.map((b) => (
            <li class="flex items-start gap-2.5 text-sm text-canvas-soft/88">
              <svg class="w-4 h-4 mt-0.5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Three feature cards (judge / window / fallback) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {features.map((f, idx) => (
        <div class="card-canvas p-7 reveal" data-delay={idx * 2}>

          <div class="flex items-center justify-between mb-5">
            <span class="text-[11px] font-mono uppercase tracking-[0.15em] text-mute">
              {f.data.label}
            </span>
            <span class="w-8 h-8 rounded-full bg-primary-pale flex items-center justify-center" aria-hidden="true">
              {f.key === 'judge' && (
                <svg class="w-4 h-4 text-positive-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
              )}
              {f.key === 'window' && (
                <svg class="w-4 h-4 text-positive-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              )}
              {f.key === 'fallback' && (
                <svg class="w-4 h-4 text-positive-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              )}
            </span>
          </div>

          <h3 class="text-xl font-extrabold tracking-tight text-ink mb-3">
            {f.data.title}
          </h3>
          <p class="text-sm text-body leading-relaxed mb-5">
            {f.data.desc}
          </p>
          <pre class="code-block text-[11px] py-3 px-4">{f.data.code}</pre>
        </div>
      ))}
    </div>

    <!-- Orchestration banner: the CTO delegates to Fast subagents -->
    <div class="mt-5 card-dark bg-ink text-canvas p-7 sm:p-9 reveal border border-ink/10" data-delay="2">
      <div class="flex items-center gap-2.5 mb-4">
        <span class="w-11 h-11 rounded-full bg-primary/15 border border-primary/25 flex items-center justify-center shrink-0" aria-hidden="true">
          <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6" cy="6" r="2.25"/><circle cx="18" cy="18" r="2.25"/>
            <path d="M8.25 6H13a3 3 0 0 1 3 3v3"/><path d="M15.75 18H11a3 3 0 0 1-3-3v-3"/>
          </svg>
        </span>
        <div>
          <div class="text-[11px] font-mono uppercase tracking-[0.15em] text-primary">
            {orch.label}
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight text-canvas mt-1">
            {orch.title}
          </h3>
        </div>
      </div>
      <p class="text-[15px] text-canvas-soft/88 leading-relaxed max-w-3xl">
        {orch.desc}
      </p>
      <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-w-3xl">
        {orch.bullets.map((b) => (
          <li class="flex items-start gap-2.5 text-sm text-canvas-soft/88">
            <svg class="w-4 h-4 mt-0.5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: fade-slide 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .reveal[data-delay="0"] { animation-delay: 0.05s; }
  .reveal[data-delay="2"] { animation-delay: 0.18s; }
</style>