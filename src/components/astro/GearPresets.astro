---
import { getTranslations, type Locale } from '../../content/locales';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const gp = t.gearPresets;

/** Filled-share of the bar per gear — visual echo of θ (lower θ = more eager). */
const barShare: Record<string, number> = {
  eco: 40,
  default: 62,
  sport: 88,
};
---

<section id="gear-presets" class="relative py-14 sm:py-20 bg-tone-1">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">

    <!-- Counterweight: the three θ values the gears actually set, drawn to
         scale — the same bar as above, at three positions. -->
    <SectionHeader label={gp.label} title={gp.title} subtitle={gp.subtitle} class="mb-10 sm:mb-12">
      <div slot="counter" class="gear-scale" data-draw>
        {gp.gears.map((g, i) => (
          <div class="gear-scale-row">
            <span class="gear-scale-name">{g.name}</span>
            <span class="gear-scale-track">
              <span class={`gear-scale-fill gear-scale-fill--${g.id}`}></span>
              <span class={`gear-scale-mark gear-scale-mark--${g.id}`}></span>
            </span>
            <span class="gear-scale-theta">{g.threshold}</span>
          </div>
        ))}
      </div>
    </SectionHeader>

    <!-- Gears -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {gp.gears.map((gear, idx) => {
        const isDefault = gear.id === 'default';
        const share = barShare[gear.id] ?? 60;
        return (
          <div class={`rounded-2xl border p-6 sm:p-7 reveal ${isDefault ? 'border-ink bg-ink text-canvas' : 'border-ink/10 bg-canvas'}`} data-delay={idx * 2}>
            <div class="flex items-baseline gap-3 mb-1">
              <code class={`text-lg font-extrabold tracking-tight ${isDefault ? 'text-primary' : 'text-ink'}`}>
                /router {gear.name}
              </code>
              {isDefault && (
                <span class="text-[10px] font-mono uppercase tracking-[0.12em] px-2 py-0.5 rounded-full bg-primary/15 text-primary">
                  {locale === 'zh' ? '默认' : 'default'}
                </span>
              )}
            </div>
            <div class={`font-mono text-xs mb-4 ${isDefault ? 'text-canvas-soft/74' : 'text-mute'}`}>
              {gear.threshold}
            </div>

            <!-- Eagerness bar: higher θ = more turns stay cheap -->
            <div class={`h-1.5 rounded-full overflow-hidden mb-4 ${isDefault ? 'bg-canvas-soft/15' : 'bg-canvas-soft'}`} aria-hidden="true">
              <div
                class="h-full rounded-full"
                style={`width: ${share}%; background: ${isDefault ? '#9fe870' : '#454745'};`}
              ></div>
            </div>

            <p class={`text-sm leading-relaxed ${isDefault ? 'text-canvas-soft/88' : 'text-body'}`}>
              {gear.desc}
            </p>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>

  /* Counterweight — θ at three positions. Lower θ = more eager to escalate. */
  .gear-scale { display: flex; flex-direction: column; gap: 0.85rem; padding-top: 0.5rem; }
  .gear-scale-row { display: grid; grid-template-columns: 4.25rem 1fr 3.5rem; align-items: center; gap: 0.75rem; }
  .gear-scale-name { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink); }
  .gear-scale-track { position: relative; height: 1.5rem; background: var(--color-tone-2); border: 1px solid var(--color-ink); border-radius: 3px; display: block; }
  /* Deep fill = the share that clears the bar, so it anchors right and grows
     with eagerness: eco is mostly cheap, sport is mostly strong. */
  .gear-scale-fill {
    position: absolute;
    inset: 0 0 0 auto;
    background: var(--color-deep);
    border-radius: 0 2px 2px 0;
    transform-origin: right center;
    transform: scaleX(0);
    transition: transform 640ms cubic-bezier(0.16, 1, 0.3, 1) 120ms;
  }
  .is-drawn .gear-scale-fill { transform: scaleX(1); }
  .gear-scale-row:nth-child(2) .gear-scale-fill { transition-delay: 220ms; }
  .gear-scale-row:nth-child(3) .gear-scale-fill { transition-delay: 320ms; }
  /* The mark is the threshold: left of it = cheap, right = strong. */
  .gear-scale-mark { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--color-primary); }
  .gear-scale-fill--eco { width: 50%; }     .gear-scale-mark--eco { left: 50%; }
  .gear-scale-fill--default { width: 67%; } .gear-scale-mark--default { left: 33%; }
  .gear-scale-fill--sport { width: 80%; }   .gear-scale-mark--sport { left: 20%; }
  .gear-scale-theta { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-body); text-align: right; }

  .reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: fade-slide 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .reveal[data-delay="0"] { animation-delay: 0.05s; }
  .reveal[data-delay="2"] { animation-delay: 0.18s; }
  .reveal[data-delay="4"] { animation-delay: 0.32s; }
</style>
