---
import { getTranslations, type Locale } from '../../content/locales';
import { quickStartTerminals } from '../../content/terminals';
import TerminalWindow from './TerminalWindow.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="quick-start" class="relative py-24 sm:py-32 bg-canvas">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">

    <!-- Section header -->
    <div class="max-w-2xl mb-14 sm:mb-20">
      <span class="eyebrow">{t.quickStart.label}</span>
      <h2 class="mt-4 text-[clamp(2rem,4vw,3.25rem)] font-extrabold tracking-tight text-ink leading-[1.05]">
        {t.quickStart.title}
      </h2>
      <p class="mt-4 text-lg text-body max-w-lg leading-relaxed">
        {t.quickStart.subtitle}
      </p>
    </div>

    <!-- Steps -->
    <ol class="space-y-6 sm:space-y-8">
      {t.quickStart.steps.map((step, idx) => {
        const term = quickStartTerminals[idx];
        return (
          <li class="reveal" data-delay={idx * 2}>

            <!-- Step meta -->
            <div class="flex items-center gap-3 mb-4 max-w-2xl">
              <span class="font-mono text-xs text-mute tracking-wider">
                {String(idx + 1).padStart(2, '0')} / {String(t.quickStart.steps.length).padStart(2, '0')}
              </span>
              <h3 class="text-base font-bold text-ink tracking-tight">{step.title}</h3>
              <span class="h-px flex-1 bg-ink/10"></span>
            </div>

            <!-- Two-column on md+: description + terminal -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-7">

              <!-- Description -->
              <div class="md:col-span-5">
                <p class="text-[15px] text-body leading-relaxed">
                  {step.desc}
                </p>

                {step.hintTitle && step.hintItems && (
                  <div class="mt-5 rounded-xl bg-canvas-soft/50 border border-ink/8 p-4">
                    <div class="text-[11px] font-mono uppercase tracking-[0.15em] text-mute mb-2.5">
                      {step.hintTitle}
                    </div>
                    <ul class="space-y-2">
                      {step.hintItems.map((item) => (
                        <li class="flex items-start gap-2 text-[13px] text-body leading-relaxed">
                          <svg class="w-3.5 h-3.5 mt-0.5 text-positive shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {step.link && (
                  <a
                    href={step.link.href}
                    class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-positive-deep hover:text-ink transition-colors group"
                  >
                    {step.link.label}
                    <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                )}
              </div>

              <!-- macOS-style terminal window -->
              <div class="md:col-span-7">
                <TerminalWindow title={term.title}>
                  <div class="terminal-body">
                    <div class="terminal-line">
                      <span class="terminal-prompt">{term.prompt}</span>
                      <span class="terminal-cmd">{term.command}</span>
                    </div>
                    {term.output.map((line) => (
                      <div class="terminal-line output">{line}</div>
                    ))}
                  </div>
                </TerminalWindow>
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .terminal-body {
    padding: 1.125rem 1.25rem 1.25rem;
    overflow-x: auto;
  }

  .terminal-line {
    white-space: pre;
    min-height: 1.4em;
  }

  .terminal-line.output {
    color: rgba(232, 235, 230, 0.7);
  }

  .terminal-prompt {
    color: #9fe870;
    margin-right: 0.5rem;
    user-select: none;
  }

  .terminal-cmd {
    color: #e8ebe6;
  }

  /* Reveal animation */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: fade-slide 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .reveal[data-delay="0"] { animation-delay: 0.05s; }
  .reveal[data-delay="2"] { animation-delay: 0.18s; }
  .reveal[data-delay="4"] { animation-delay: 0.32s; }
</style>