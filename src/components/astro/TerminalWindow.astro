---
/**
 * Reusable macOS-style terminal window chrome.
 *
 * Renders the title bar with three colored dots and a centered title. The
 * actual body content (status panel, command line, log lines, etc.) is
 * provided via the default slot so each consumer keeps its own scoped styles.
 *
 * Usage:
 *   <TerminalWindow title="pi — zsh">
 *     <div class="terminal-body">...your content...</div>
 *   </TerminalWindow>
 */

interface Props {
  /** Window title shown in the centered title bar */
  title: string;
  /** Optional class for the outer wrapper */
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class:list={['terminal-window', className]}>
  <div class="terminal-bar">
    <div class="terminal-dots" aria-hidden="true">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>
    <div class="terminal-title">{title}</div>
    <div class="terminal-actions" aria-hidden="true">
      <svg class="w-3 h-3 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg>
    </div>
  </div>
  <div class="terminal-content">
    <slot />
  </div>
</div>

<style>
  .terminal-window {
    background: var(--color-ink);
    color: #e8ebe6;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(14, 15, 12, 0.25), 0 4px 8px -4px rgba(14, 15, 12, 0.1);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.625rem 1rem;
    height: 2.25rem;
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
  }

  .dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    display: block;
  }
  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }

  .terminal-title {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(232, 235, 230, 0.55);
    letter-spacing: 0.01em;
  }

  .terminal-actions {
    width: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(232, 235, 230, 0.55);
  }

  .terminal-content {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: rgba(232, 235, 230, 0.92);
  }
</style>