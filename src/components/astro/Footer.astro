---
import { getTranslations, swapLocalePrefix, type Locale } from '../../content/locales';

interface Props {
  locale: Locale;
  pathname?: string;
}

const { locale, pathname = '/' } = Astro.props;
const t = getTranslations(locale);

const otherLocale: Locale = locale === 'en' ? 'zh' : 'en';
const otherLocaleHref = swapLocalePrefix(pathname, otherLocale);
const otherLocaleLabel = otherLocale === 'zh' ? t.nav.zhLabel : t.nav.enLabel;
---

<footer class="bg-ink text-canvas-soft">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-10 sm:py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-x-8 gap-y-10 md:gap-y-0">

      <!-- Brand column -->
      <div class="sm:col-span-2 md:col-span-4">
        <a href={locale === 'zh' ? '/zh/' : '/'} class="flex items-center gap-2.5 group" aria-label="Home">
          <span class="w-8 h-8 rounded-lg bg-canvas-soft/10 flex items-center justify-center border border-canvas-soft/15" aria-hidden="true">
            <svg viewBox="0 0 64 64" class="w-5 h-5">
              <path d="M18 22h28M18 32h20M18 42h28" stroke="#9fe870" stroke-width="5" stroke-linecap="round"/>
              <circle cx="46" cy="32" r="4" fill="#9fe870"/>
            </svg>
          </span>
          <span class="text-[15px] font-extrabold tracking-tight text-canvas">
            {t.footer.brand}
          </span>
        </a>
        <p class="mt-4 text-sm text-canvas-soft/70 leading-relaxed max-w-sm">
          {t.footer.tagline}
        </p>
        <p class="mt-5 text-xs text-canvas-soft/50">
          {t.footer.copyright}
        </p>
      </div>

      <!-- Link columns -->
      <div class="md:col-span-2">
        <h3 class="text-[11px] font-mono uppercase tracking-[0.15em] text-primary mb-4">
          {t.footer.sections.product.title}
        </h3>
        <ul class="space-y-2.5">
          {t.footer.sections.product.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-canvas-soft/75 hover:text-canvas transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <h3 class="text-[11px] font-mono uppercase tracking-[0.15em] text-primary mb-4">
          {t.footer.sections.resources.title}
        </h3>
        <ul class="space-y-2.5">
          {t.footer.sections.resources.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-canvas-soft/75 hover:text-canvas transition-colors inline-flex items-center gap-1.5">
                {link.label}
                <svg class="w-3 h-3 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <h3 class="text-[11px] font-mono uppercase tracking-[0.15em] text-primary mb-4">
          {t.footer.sections.friends.title}
        </h3>
        <ul class="space-y-2.5">
          {t.footer.sections.friends.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-canvas-soft/75 hover:text-canvas transition-colors inline-flex items-center gap-1.5">
                {link.label}
                <svg class="w-3 h-3 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Language -->
      <div class="md:col-span-2">
        <h3 class="text-[11px] font-mono uppercase tracking-[0.15em] text-primary mb-4">
          {t.footer.languageLabel}
        </h3>
        <ul class="space-y-2.5">
          <li>
            <a
              href={otherLocaleHref}
              hreflang={otherLocale}
              class="text-sm text-canvas-soft/75 hover:text-canvas transition-colors inline-flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              {otherLocaleLabel}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-canvas-soft/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-canvas-soft/45">
      <span>MIT License · v0.8.2-web</span>
      <span class="font-mono">pi-shift-router · router for {`{`}fast,smart{`}`}</span>
    </div>
  </div>
</footer>