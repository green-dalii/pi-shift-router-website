---
import { getTranslations, type Locale } from '../../content/locales';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="faq" class="relative py-14 sm:py-20 bg-canvas">
  <div class="max-w-4xl mx-auto px-5 sm:px-8">

    <SectionHeader label={t.faq.label} title={t.faq.title} subtitle={t.faq.subtitle}
      counterNote="Ordered the way a first-time reader asks them.">
      <div slot="counter" class="faq-count">
        <span class="faq-count-num">{String(t.faq.items.length).padStart(2, '0')}</span>
        <span class="faq-count-label">questions</span>
      </div>
    </SectionHeader>

    <!-- Accordion -->
    <div class="space-y-3">
      {t.faq.items.map((item, idx) => (
        <details
          class="group card-sage px-6 sm:px-7 py-5 sm:py-6 reveal"
          data-delay={idx * 2}
          open={idx === 0}
        >
          <summary class="flex items-start justify-between gap-4 cursor-pointer select-none list-none w-full min-w-0">
            <h3 class="text-base sm:text-lg font-extrabold tracking-tight text-ink pr-2 flex-1 min-w-0">
              {item.q}
            </h3>
            <span class="shrink-0 w-8 h-8 rounded-full bg-canvas border border-ink/10 flex items-center justify-center">
              <svg class="w-4 h-4 text-ink transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-ink/10">
            <p class="text-body-md text-body leading-relaxed">
              {item.a}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>

  /* Counterweight — the count, at display scale. */
  .faq-count { display: flex; align-items: baseline; gap: 0.75rem; border-top: 1px solid var(--color-ink); padding-top: 0.875rem; }
  .faq-count-num { font-family: var(--font-display); font-size: 3.5rem; font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: var(--color-ink); }
  .faq-count-label { font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-mute); }

  /* Chrome keeps a details marker glyph that `list-none` does not remove;
     it adds ~7px and makes the row overflow its own box. */
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: fade-slide 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .reveal[data-delay="0"] { animation-delay: 0.05s; }
  .reveal[data-delay="2"] { animation-delay: 0.18s; }
  .reveal[data-delay="4"] { animation-delay: 0.32s; }
  .reveal[data-delay="6"] { animation-delay: 0.46s; }
  .reveal[data-delay="8"] { animation-delay: 0.6s; }
  .reveal[data-delay="10"] { animation-delay: 0.74s; }

  details summary::-webkit-details-marker { display: none; }
</style>