---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import QuickStart from '../../components/astro/QuickStart.astro';
import UseCases from '../../components/astro/UseCases.astro';
import Models from '../../components/astro/Models.astro';
import FAQ from '../../components/astro/FAQ.astro';
import { getTranslations } from '../../content/locales';

const t = getTranslations('zh');
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  keywords={t.meta.keywords}
  locale="zh"
  pathname="/zh/"
>
  <Hero locale="zh" />
  <QuickStart locale="zh" />
  <Models locale="zh" />
  <UseCases locale="zh" />
  <FAQ locale="zh" />
</BaseLayout>