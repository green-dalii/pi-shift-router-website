---
/**
 * 404 — deliberately not localised. A visitor who mistyped a URL is not in a
 * locale yet, so the page names both editions and offers both languages rather
 * than guessing.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TierIcon from '../components/astro/TierIcon.astro';

const paths = [
  { href: '/', label: 'Home', note: 'English' },
  { href: '/zh/', label: '首页', note: '简体中文' },
  { href: '/models/', label: 'Models', note: 'Which two to pick' },
  { href: '/zh/models/', label: '模型', note: '选哪两个' },
];
---

<BaseLayout
  locale="en"
  pathname="/404"
  title="Not found — Shift Router"
  description="That page does not exist. The two editions and both languages are one click away."
  noindex
>
  <section class="relative min-h-[calc(100vh-4rem)] flex items-center py-20">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 w-full">
      <span class="eyebrow">404</span>

      <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
        <div class="lg:col-span-7">
          <h1 class="font-display font-extrabold text-ink tracking-tight leading-[1.02] balance text-[clamp(2.25rem,5.5vw,4.25rem)]">
            This route goes nowhere.
          </h1>
          <p class="mt-6 text-body-lg text-body leading-relaxed max-w-md">
            No model needed for this one — the URL simply does not exist.
          </p>
          <a href="/" class="btn-primary mt-9">
            <TierIcon tier="fast" size={16} />
            Back to the start
          </a>
        </div>

        <div class="lg:col-span-5">
          <ul class="border-t border-ink">
            {paths.map((p) => (
              <li class="border-b border-ink/12">
                <a
                  href={p.href}
                  class="flex items-baseline justify-between gap-4 py-3 group"
                >
                  <span class="text-body-sm font-semibold text-ink group-hover:text-positive-deep transition-colors">{p.label}</span>
                  <span class="font-mono text-[11px] text-mute">{p.note}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
